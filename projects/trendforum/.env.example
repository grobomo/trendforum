# TrendForum Environment Variables
# Copy to .env and fill in values

# Database URL
DATABASE_URL="file:./dev.db"

# JWT secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: override password hashes (otherwise set via seed / DB Config table)
# Generate with: node -e "require('bcryptjs').hash('yourpass', 10).then(console.log)"
# WIFI_PASSWORD_HASH=
# ADMIN_PASSWORD_HASH=

# Coconut Bot - LLM-powered replies (optional)
# Get an API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Set to "true" to enable LLM replies (falls back to templates if unset or on failure)
# COCONUT_LLM=true
